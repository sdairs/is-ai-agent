{
  "redacted": "<redacted>",
  "sensitive_name": "TOKEN|KEY|SECRET|PASSWORD|CREDENTIAL|AUTH|COOKIE|SESSION.*ID|THREAD.*ID|TASK.*ID|TRACE|REQUEST.*ID|UUID",
  "literals": ["", "0", "1", "true", "false", "yes", "no", "on", "off", "none", "null", "dumb", "xterm", "xterm-256color", "screen", "screen-256color", "ansi", "24bit", "truecolor", "256color", "C", "C.UTF-8", "en_US.UTF-8", "UTF-8", "utf-8", "linux", "node", "root", "production", "development", "test", "ci"],
  "identity_names": ["AGENT", "AI_AGENT"],
  "identity_pattern": "^(?:claude-code|claude_code|claude|codex|cursor|cursor-cli|gemini-cli|gemini|goose|amp|opencode|cline|github-copilot|github_copilot_vscode_agent|copilot|crush|qwen-code|qwen|pi|dsh|deepseek-harness|kilo|kilo-code|kilocode|openclaw|hermes|hermes-agent|vtcode|junie)(?:(?:@|_|-)\\d+(?:[._-]\\d+){0,5}(?:_(?:agent|cli))?)?$",
  "version_names": ["NODE_VERSION", "YARN_VERSION", "CODEX_VERSION"],
  "version_pattern": "^\\d+\\.\\d+\\.\\d+(?:-[A-Za-z]+[.-]?\\d+)?$",
  "by_name": {
    "OPENCLAW_SHELL": ["exec", "tui-local", "acp-client", "acp"],
    "SHELL": ["/bin/bash", "/bin/sh", "/bin/zsh", "/usr/bin/bash", "/usr/bin/zsh"],
    "TERM_PROGRAM": ["vscode", "Apple_Terminal", "iTerm.app", "ghostty", "WezTerm"]
  }
}
